{
    "layout": {
        "type": "grid",
        "rows": 2,
        "cols": 2,
        "hspace": "2mm",
        "vspace": "2mm",
        "alternation": "rows",
        "renameref": "{orig}_{n}"
    },
    "tabs": {
        "type": "fixed",
        "vwidth": "5mm",
        "hwidth": "5mm",
        "vcount": 0,
        "hcount": 1
    },
    "cuts": {
        "type": "mousebites",
        "drill": "0.6mm",
        "spacing": "0.95mm",
        "offset": "0.2mm",
        "prolong": "0.5mm"
    },
    "framing": {
        "type": "railslr",
        "width": "5mm",
        "space": "2mm"
    },
    "tooling": {
        "type": "3hole",
        "hoffset": "2.5mm",
        "voffset": "2.5mm",
        "size": "1.152mm",
        "paste": false,
        "soldermaskmargin": "1.3mm"
    },
    "fiducials": {
        "type": "3fid",
        "hoffset": "2.5mm",
        "voffset": "8mm",
        "coppersize": "1mm",
        "opening": "2mm"
    },
    "post": {
        "millradius": "1mm"
    }
}
