#!/bin/sh
# KiCad's own Python, the one with pcbnew, from whichever KiCad this machine
# has: the macOS app's bundled Python, or the Flathub Flatpak (org.kicad.KiCad)
# on Linux. Run rear_panels.py with it, and install KiKit into tools/kicad/.kikit
# with it (see tools/kicad/README.md → Panels). $KICAD_PYTHON overrides it in
# jlc_fab.py.
#
# The Flatpak doesn't inherit PYTHONPATH (jlc_fab.py sets it for KiKit and
# rodeo_tabs.py), so it's passed in, and /tmp is shared as for kicad-cli.
# Any version, so a KiCad update that moves the bundled Python doesn't break it.
for mac in /Applications/KiCad/KiCad.app/Contents/Frameworks/Python.framework/Versions/*/bin/python3; do
  if [ -x "$mac" ]; then
    exec "$mac" "$@"
  fi
done
if command -v flatpak >/dev/null 2>&1 && flatpak info org.kicad.KiCad >/dev/null 2>&1; then
  exec flatpak run --filesystem=/tmp --env=PYTHONPATH="${PYTHONPATH:-}" \
    --command=python3 org.kicad.KiCad "$@"
fi
echo "kicad-python: no KiCad found (the macOS app, or the Flatpak org.kicad.KiCad)" >&2
exit 127
