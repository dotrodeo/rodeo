---
// Starlight's header is otherwise a dead end: it links only to /sdk/, so a
// visitor who lands on a docs page has no route back to the site. This puts
// the wordmark (to /) and the main nav in the docs header, so /sdk/ reads as
// a section of the site rather than a separate one.
import { site } from '../../data/site';
---

<div class="rodeo-site-title">
  <a href="/" class="rodeo-wordmark">Rodeo</a>
  <span class="rodeo-section">rodeo-sdk</span>
  <nav class="rodeo-links" aria-label="Site">
    {
      site.nav
        .filter((i) => i.href !== '/' && i.href !== '/sdk/' && !i.pending)
        .map((i) => (
          <a href={i.href}>{i.label}</a>
        ))
    }
  </nav>
</div>

<style>
  .rodeo-site-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .rodeo-wordmark {
    font-family: 'Barlow', system-ui, sans-serif;
    font-weight: 900;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--palette-white);
    text-decoration: none;
    flex-shrink: 0;
  }
  .rodeo-wordmark:hover {
    color: var(--palette-yellow);
  }
  .rodeo-section {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--palette-black);
    background: var(--palette-yellow);
    padding: 0.15rem 0.4rem;
    flex-shrink: 0;
  }
  .rodeo-links {
    display: none;
    gap: 1rem;
  }
  .rodeo-links a {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.82rem;
    color: var(--palette-gray);
    text-decoration: none;
  }
  .rodeo-links a:hover {
    color: var(--palette-yellow);
  }
  @media (min-width: 72rem) {
    .rodeo-links {
      display: flex;
    }
  }
</style>
