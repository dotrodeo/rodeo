---
// A photograph or diagram inside a build-log post.
//
// `alt` is required and the component throws without it, the same rule
// BoardFigure enforces. A log post full of unlabelled images is unreadable to
// anyone using a screen reader and useless to search.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Shown under the image. Markdown is not parsed here — keep it a sentence. */
  caption?: string;
  /** `wide` breaks out of the reading measure; `full` goes edge to edge. */
  width?: 'text' | 'wide';
  loading?: 'eager' | 'lazy';
}

const { src, alt, caption, width = 'text', loading = 'lazy' } = Astro.props;

if (!alt?.trim()) throw new Error('log/Figure: `alt` is required.');

// The post body is capped at a reading measure; `wide` escapes it on large
// screens only, where there is room either side.
const frame = width === 'wide' ? 'lg:-mx-[12%]' : '';
---

<figure class={`my-8 ${frame}`}>
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1200]}
    sizes="(max-width: 768px) 100vw, 680px"
    loading={loading}
    class="block h-auto w-full"
  />
  {
    caption && (
      <figcaption class="mt-3 border-l-2 border-rule py-1 pl-3 font-mono text-[12.5px] leading-relaxed text-hardware">
        {caption}
      </figcaption>
    )
  }
</figure>
