---
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Pages with nothing to rank, like the signup confirmation. */
  noindex?: boolean;
  /**
   * Open Graph card, as a site-absolute path. One of the committed cards in
   * public/og/, regenerated by scripts/make-og.mjs.
   */
  image?: string;
}

const {
  title,
  description = site.description,
  noindex = false,
  image = '/og/default.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Open Graph requires an absolute URL — a relative one is silently dropped by
// every scraper, which is how you end up with a blank card.
const ogImage = new URL(image, Astro.site).href;
const fullTitle = title === site.name ? title : `${title} — ${site.name}`;

// Preview deploys must never be indexed under the real brand. `_headers`
// cannot condition on hostname, so this is gated at build time instead.
const isProduction = import.meta.env.SITE_ENV === 'production';
const robots = !isProduction || noindex;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="dark" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{robots && <meta name="robots" content="noindex,nofollow" />}
<meta property="og:type" content="website" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${description}`} />
<meta property="og:site_name" content={site.name} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
