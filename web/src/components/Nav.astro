---
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';

const path = Astro.url.pathname;

// '/' would prefix-match everything, so the home item is matched exactly.
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="border-b border-rule">
  <nav
    class="wrap flex flex-wrap items-center gap-x-6 gap-y-3 py-4"
    aria-label="Primary"
  >
    <Wordmark href="/" />
    <div class="grow"></div>
    {
      site.nav.map((item) =>
        isActive(item.href) ? (
          <span class="font-mono text-[14px] text-yellow" aria-current="page">
            {item.label}
          </span>
        ) : item.pending ? (
          <span class="font-mono text-[14px] text-hardware" title="Coming soon">
            {item.label}
          </span>
        ) : (
          <a href={item.href} class="font-mono text-[14px] text-legend no-underline hover:text-yellow">
            {item.label}
          </a>
        )
      )
    }
  </nav>
</header>
