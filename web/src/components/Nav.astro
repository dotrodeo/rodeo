---
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';

const path = Astro.url.pathname;

// '/' would prefix-match everything, so the home item is matched exactly.
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const link = 'font-mono text-[14px] leading-none no-underline';
---

<header class="min-h-16 border-b border-rule">
  <nav class="wrap flex min-h-[calc(4rem-1px)] flex-wrap items-center gap-x-6 py-2" aria-label="Primary">
    <Wordmark href="/" />
    <div class="grow"></div>

    <ul class="m-0 hidden list-none items-center gap-6 p-0 md:flex">
      {
        site.nav.map((item) => (
          <li class="flex">
            {isActive(item.href) ? (
              <span class={`${link} text-yellow`} aria-current="page">
                {item.label}
              </span>
            ) : item.pending ? (
              <span class={`${link} text-hardware`} title="Coming soon">
                {item.label}
              </span>
            ) : (
              <a href={item.href} class={`${link} text-legend hover:text-yellow`}>
                {item.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <a
      href="https://github.com/dotrodeo/rodeo"
      class="hidden h-9 w-9 shrink-0 items-center justify-center text-legend hover:text-yellow md:flex"
      aria-label="Rodeo on GitHub"
    >
      <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        ></path>
      </svg>
    </a>

    <button
      id="nav-toggle"
      type="button"
      class="-mr-2.5 flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center border-none bg-transparent text-legend hover:text-yellow md:hidden"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="sr-only">Menu</span>
      <svg
        class="icon-menu"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="square"
        aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg
      >
      <svg
        class="icon-close"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="square"
        aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg
      >
    </button>

    <div id="nav-menu" class="w-full basis-full md:hidden">
      <ul class="m-0 flex list-none flex-col p-0 pt-3">
        {
          site.nav.map((item) => (
            <li class="border-t border-rule">
              {isActive(item.href) ? (
                <span class={`${link} block py-3.5 text-yellow`} aria-current="page">
                  {item.label}
                </span>
              ) : item.pending ? (
                <span class={`${link} block py-3.5 text-hardware`}>
                  {item.label} <span class="text-[12px]">— soon</span>
                </span>
              ) : (
                <a href={item.href} class={`${link} block py-3.5 text-legend hover:text-yellow`}>
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<style>
  /* Icon state is driven off aria-expanded, so the button's accessible state
     and its appearance cannot drift apart. */
  #nav-toggle[aria-expanded='true'] .icon-menu,
  #nav-toggle[aria-expanded='false'] .icon-close {
    display: none;
  }
</style>

<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');

  if (btn && menu) {
    const isOpen = () => btn.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };

    // The panel ships visible, so without JS every link is still reachable.
    // It only collapses once this runs and the button can reopen it.
    setOpen(false);

    btn.addEventListener('click', () => setOpen(!isOpen()));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        btn.focus();
      }
    });
  }
</script>
