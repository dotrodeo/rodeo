---
// A catalogue card.
//
// Every Rev-B board is unfabricated, so there is nothing to photograph: a card
// shows the board's CAD render, captioned as one, or its outline when there is
// no render either. Below it, the two specs that actually distinguish the
// board — which is what a builder is scanning for.
import { Image } from 'astro:assets';
import Chip from './Chip.astro';
import BoardPlaceholder from './BoardPlaceholder.astro';
import type { Board } from '../data/boards';
import { statusLabel } from '../data/site';

interface Props {
  board: Board;
}

const { board } = Astro.props;
const lead = board.specs.slice(0, 2);
---

<li class="h-full">
  <a
    href={`/ecosystem/${board.slug}/`}
    class="group flex h-full flex-col gap-4 border border-rule bg-field-raised p-5 text-legend no-underline hover:border-yellow"
  >
    {
      board.shot ? (
        <figure class="m-0">
          <Image
            src={board.shot.src}
            alt={board.shot.alt}
            widths={[400, 700]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 380px"
            loading="lazy"
            class="block aspect-square h-auto w-full rounded-[8px] object-cover"
          />
          <figcaption class="mt-2 font-mono text-[11.5px] text-hardware">
            <span class="text-legend">
              {board.shot.rev === 'prototype' ? 'Prototype' : `Rev-${board.shot.rev}`}
            </span>{' '}
            · {board.shot.media === 'photo' ? 'photo' : 'CAD render'}
          </figcaption>
        </figure>
      ) : board.outline ? (
        <BoardPlaceholder outline={board.outline} rev={board.rev} class="w-full" />
      ) : null
    }

    <div class="flex flex-wrap items-center gap-2">
      <h3 class="display m-0 text-[17px] normal-case group-hover:text-yellow">{board.name}</h3>
      <Chip variant="status" status={board.status}>{statusLabel[board.status]}</Chip>
    </div>

    <p class="copy-tech m-0 text-[14px]">{board.summary}</p>

    <dl class="m-0 flex flex-col gap-1.5 border-t border-rule pt-3 font-mono text-[12.5px]">
      {
        lead.map((s) => (
          <div class="flex gap-3">
            <dt class="m-0 w-[9rem] shrink-0 text-hardware">{s.label}</dt>
            <dd class="m-0 min-w-0 text-legend">{s.value}</dd>
          </div>
        ))
      }
    </dl>

    <span class="mt-auto pt-1 font-mono text-[12px] text-hardware">Rev-{board.rev}</span>
  </a>
</li>
