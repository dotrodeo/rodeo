---
// The waitlist form. One component so the band and the /subscribe/ page cannot
// drift apart — the honeypot, the consent line and the Turnstile widget have to
// be identical everywhere or the Worker's checks stop matching the markup.
//
// It posts to /api/subscribe, not /subscribe/, because a static page exists at
// the latter. See worker/index.ts.
interface Props {
  /** Recorded in the Worker's logs: home, subscribe-page, post:<slug>, … */
  source: string;
  /** `band` sits on indigo; `page` sits on the page background. */
  variant?: 'band' | 'page';
}

const { source, variant = 'band' } = Astro.props;

// Two forms on one page would collide on these.
const uid = source.replace(/[^a-z0-9]+/gi, '-').toLowerCase();

// Unset until the Turnstile keys exist. The widget then appears and the Worker
// starts enforcing it; neither half needs a code change.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const note = variant === 'band' ? 'text-legend' : 'text-hardware';
---

<form method="post" action="/api/subscribe" class="flex max-w-[560px] flex-col gap-3">
  <input type="hidden" name="source" value={source} />

  {/* Off-screen rather than display:none — a bot that renders CSS skips the
      latter. aria-hidden and tabindex keep it away from everyone else. */}
  <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
    <label for={`b_name-${uid}`}>Leave this field empty</label>
    <input id={`b_name-${uid}`} name="b_name" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="flex flex-col gap-3 sm:flex-row">
    <label for={`email-${uid}`} class="sr-only">Email address</label>
    <input
      id={`email-${uid}`}
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
      class="min-w-0 grow border-[1.5px] border-legend bg-field px-4 py-3.5 font-mono text-[15px] text-legend placeholder:text-hardware"
    />
    <button
      type="submit"
      class="shrink-0 cursor-pointer border-none bg-yellow px-7 py-4 font-display text-[16px] font-black uppercase tracking-[0.04em] text-field hover:bg-legend"
      >Join the waitlist</button
    >
  </div>

  {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="dark"></div>}

  <p class={`copy-tech m-0 text-[13px] ${note}`}>
    You will get one email asking you to confirm. Nothing else until there is
    something to say, and unsubscribe from any of it.
  </p>
</form>

{
  siteKey && (
    <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js" />
  )
}
