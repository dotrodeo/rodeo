---
// Stands in for a board with neither a photograph nor a render.
//
// Not a grey box: the rectangle is the board's real outline, measured off its
// KiCad Edge.Cuts layer, so a reader still learns the shape and the scale —
// which is most of what a catalogue photograph tells you anyway. A board with
// a render shows that instead (its `shot` in src/data/boards.ts).
interface Props {
  outline: { w: number; h: number };
  /** Caption, matching BoardFigure's grammar so the two read alike. */
  rev: string;
  class?: string;
}

const { outline, rev, class: klass = '' } = Astro.props;

// Fit the board inside the frame, longest edge first, so a 20 × 100 strip and
// a 90 × 112 motherboard are shown at the same scale relative to each other.
const longest = Math.max(outline.w, outline.h);
const wPct = (outline.w / longest) * 100;
const hPct = (outline.h / longest) * 100;
---

<figure class={`m-0 ${klass}`}>
  <div
    class="flex aspect-square w-full items-center justify-center border border-rule bg-field p-6"
    role="img"
    aria-label={`No photograph yet. Board outline, ${outline.w} by ${outline.h} millimetres.`}
  >
    <div
      class="relative border border-dashed border-hardware/60"
      style={`width:${wPct}%;height:${hPct}%`}
    >
      <span
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 whitespace-nowrap font-mono text-[11.5px] text-hardware"
      >
        {outline.w} × {outline.h} mm
      </span>
    </div>
  </div>
  <figcaption
    class="mt-3 inline-flex items-center gap-3 border-l-2 border-rule bg-field-raised py-1.5 pl-3 pr-4 font-mono text-[12px] text-hardware"
  >
    <span class="whitespace-nowrap text-legend">Rev-{rev}</span>— outline only · no photograph yet
  </figcaption>
</figure>
