---
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-rule">
  <div
    class="wrap flex flex-col gap-3 py-8 text-[14px] text-hardware sm:flex-row sm:items-baseline"
  >
    <p class="m-0">© {year} Rodeo</p>
    {/* /subscribe/ is in the sitemap, so it needs a link into it from
        somewhere that is not a form the crawler will not follow. */}
    <a href="/subscribe/" class="text-hardware no-underline hover:text-yellow">Waitlist</a>
    <div class="grow"></div>
    <p class="m-0 font-mono text-[12px]">
      Hardware and firmware sources are published with the boards.
    </p>
  </div>
</footer>
