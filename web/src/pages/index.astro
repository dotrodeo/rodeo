---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BoardFigure from '../components/BoardFigure.astro';
import CtaBand from '../components/CtaBand.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { boards, host } from '../data/boards';
import heroImg from '../assets/hardware/rev-b/rodeo-motherboard-wide.webp';
import { site } from '../data/site';

// Numbered in the data so they cannot run 01, 02, 01 again.
const steps = [
  {
    title: 'Pick your controls',
    body: 'Satellites carry four pots or four encoders on a 25 mm grid. Each one reads its own controls and passes them along, so another four is another satellite — not another motherboard.',
  },
  {
    title: 'Chain them up',
    body: 'One cable from satellite to satellite, and the last one closes the ring by itself. Position in the chain is the address, so there is nothing to configure and no jumpers to set.',
  },
  {
    title: 'Give it a voice',
    body: 'A Daisy Seed does the DSP with libDaisy and DaisySP, and rodeo-sdk handles the hardware around it. USB already works — audio, MIDI and serial at once. The chain and codec drivers are being written in the open.',
  },
];

// The boards being sold, as CAD renders until they are back from the fab and
// can be photographed. BoardFigure and the strip's captions say so. Nothing on
// this page refers to the Rev-A prototype; /prototype/ tells that story.
const hero = {
  src: heroImg,
  alt: 'Render of the Rodeo motherboard at an angle on a warm backdrop: a square black board with the empty Daisy Seed footprint across the middle, the boxed audio-interface ribbon header and a microSD slot on one edge, and rows of white connectors labelled GPIO TAPS, CHAIN, SPI, MIDI and SWITCH.',
  media: 'render' as const,
  rev: host.rev,
  caption: 'the motherboard',
};
// One per step below: controls, then more controls, then the sound.
const strip = ['rodeo-pot-bank-4', 'rodeo-encoder-bank-4', 'rodeo-audio-3.5mm'].map((slug) => {
  const b = boards.find((x) => x.slug === slug);
  if (!b?.shot) throw new Error(`homepage strip: ${slug} has no render`);
  return { name: b.name, ...b.shot };
});
---

<BaseLayout title={site.name} description={site.description}>
  <section class="wrap flex flex-col gap-12 pb-4 pt-14 lg:flex-row lg:gap-16">
    <h1 class="display m-0 max-w-[560px] text-[clamp(48px,7.5vw,78px)] lg:shrink-0">
      Maybe it is your first rodeo
    </h1>
    <div class="flex min-w-0 flex-col gap-7 lg:pt-2">
      <p class="copy-tech m-0 max-w-[560px] text-[17px]">
        <span class="font-display font-black text-legend">RODEO</span> is a carrier board for the
        Electrosmith Daisy and a chain of control satellites. Four ins, four outs, ten I/O
        connectors, and as many knobs as your panel has room for — without you drawing a single
        PCB. It runs on a battery and charges over USB-C, so what you build can leave the
        desk.
      </p>
      <p class="copy-tech m-0 max-w-[560px] text-[14.5px] text-hardware">
        The boards are drawn, routed and ordered from the fab — not built, not powered on
        yet. This site is careful about which is which — see
        <a href="/ecosystem/" class="text-yellow">the boards</a>.
      </p>
      <div class="flex flex-wrap items-stretch gap-4">
        <a
          href="#waitlist"
          class="bg-yellow px-7 py-4 font-display text-[16px] font-black uppercase tracking-[0.04em] text-field no-underline hover:bg-legend"
          >Join the waitlist</a
        >
        <a
          href="/ecosystem/"
          class="border-[1.5px] border-legend px-7 py-[14.5px] font-display text-[16px] font-black uppercase tracking-[0.04em] text-legend no-underline hover:border-yellow hover:text-yellow"
          >See the boards</a
        >
      </div>
    </div>
  </section>

  <section class="wrap pb-16 pt-10">
    <BoardFigure
      src={hero.src}
      alt={hero.alt}
      media={hero.media}
      rev={hero.rev}
      caption={hero.caption}
      loading="eager"
      widths={[700, 1100, 1600, 2400]}
      sizes="(max-width: 1240px) 100vw, 1176px"
    />
  </section>

  <section class="bg-yellow py-10">
    {/* .wrap goes on a plain div, not on the <ul>. Its `margin-inline: auto`
        lives in @layer components, so a `m-0` utility on the same element
        wins and the whole strip silently left-aligns. */}
    <div class="wrap">
      <ul class="m-0 grid list-none grid-cols-1 gap-7 p-0 sm:grid-cols-3">
        {
          strip.map((shot) => (
            <li>
              <figure class="m-0">
                <Image
                  src={shot.src}
                  alt={shot.alt}
                  widths={[400, 700]}
                  sizes="(max-width: 640px) 100vw, 380px"
                  loading="lazy"
                  class="block aspect-square h-auto w-full rounded-[10px] object-cover"
                />
                <figcaption class="mt-2.5 font-mono text-[12px] text-field">
                  <span class="font-bold">Rev-{shot.rev}</span> — {shot.name} ·{' '}
                  {shot.media === 'photo' ? 'photo' : 'CAD render'}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wrap py-20">
    <Eyebrow>How does it work?</Eyebrow>
    <h2 class="display mb-10 mt-4 max-w-[760px] text-[clamp(34px,5.5vw,54px)]">
      A motherboard and her satellites
    </h2>
    <ul class="m-0 grid list-none gap-6 p-0 md:grid-cols-3">
      {
        steps.map((s, i) => (
          <li class="flex flex-col gap-3 border border-rule bg-field-raised p-6">
            <span class="font-mono text-[13px] text-indigo-text">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="display m-0 text-[20px]">{s.title}</h3>
            <p class="copy-tech m-0 text-[14.5px]">{s.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand source="home" />
</BaseLayout>
