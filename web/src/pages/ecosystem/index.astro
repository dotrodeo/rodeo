---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Chip from '../../components/Chip.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import SpecTable from '../../components/SpecTable.astro';
import BoardCard from '../../components/BoardCard.astro';
import BoardFigure from '../../components/BoardFigure.astro';
import CtaBand from '../../components/CtaBand.astro';
import { host, satellites, daughterboards } from '../../data/boards';
import { statusLabel } from '../../data/site';

// Still no photographs: the Rev-B boards are built now, but nobody has
// photographed them, so they are shown as CAD renders and captioned as such.
// Swap a board's `shot` in boards.ts the day there is a picture of it.
//
// The key below is built from the statuses actually in use, so it never
// explains a badge that is not on the page — `at-fab` emptied out the day the
// first run arrived, and the key emptied with it.
const ladder = [
  { status: 'shipped' as const, note: 'a bring-up test passed on it' },
  { status: 'built' as const, note: 'on the bench, nothing proven yet' },
  { status: 'at-fab' as const, note: 'ordered and being made' },
  { status: 'designed' as const, note: 'drawn and routed, never ordered' },
  { status: 'in-progress' as const, note: 'being drawn right now' },
  { status: 'planned' as const, note: 'specified, not yet drawn' },
];
const inUse = new Set([host, ...satellites, ...daughterboards].map((b) => b.status));
const legend = ladder
  .filter((l) => inUse.has(l.status))
  .map((l) => ({ ...l, label: statusLabel[l.status] }));
---

<BaseLayout
  image="/og/ecosystem.png"
  title="The boards"
  description="One host board and the satellites that plug into it. Every entry links to its schematic, KiCad project, gerbers, BOM and pinout."
>
  <section class="wrap flex flex-col gap-10 py-14 lg:flex-row lg:items-end">
    <div class="flex grow flex-col gap-4">
      <Eyebrow>The platform</Eyebrow>
      <h1 class="display m-0 max-w-[720px] text-[clamp(42px,7vw,64px)]">
        One host board and the satellites that plug into it
      </h1>
      <p class="copy-tech m-0 max-w-[620px] text-[16px]">
        Every entry links to its schematic, KiCad project, gerbers, BOM and pinout. These are
        the Rev-B boards, the ones the campaign ships. <strong class="text-legend">The first
        run arrived on 28 October and bring-up has been running since: six of these boards
        have had a test pass on them, two are on the bench untouched, and three were drawn
        after the order went in.</strong> The badge on each says which, and nothing here
        claims a measurement that has not been taken.
      </p>
    </div>
    <ul class="m-0 flex list-none flex-col gap-2.5 p-0">
      {
        legend.map((l) => (
          <li class="flex items-center gap-2.5">
            <Chip variant="status" status={l.status}>
              {l.label}
            </Chip>
            <span class="text-[13.5px] text-hardware">{l.note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap pb-6">
    <div class="flex flex-col gap-10 border border-rule bg-field-raised p-6 sm:p-8 lg:flex-row">
      {
        host.shot && (
          <div class="lg:w-[40%] lg:shrink-0">
            <BoardFigure
              src={host.shot.src}
              alt={host.shot.alt}
              media={host.shot.media}
              rev={host.shot.rev}
              caption={host.shot.caption}
              widths={[480, 800, 1200]}
              sizes="(max-width: 1024px) 100vw, 460px"
            />
          </div>
        )
      }
      <div class="flex min-w-0 grow flex-col gap-5">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="display m-0 text-[clamp(26px,3.4vw,34px)] normal-case">{host.name}</h2>
          <Chip variant="status" status={host.status}>{statusLabel[host.status]}</Chip>
        </div>
        <p class="copy-tech m-0 text-[15.5px]">{host.body}</p>
        <SpecTable specs={host.specs} />
        {
          host.caveats?.map((c) => (
            <div class="flex items-start gap-3 border-l-2 border-rule bg-field p-4">
              <Chip variant="status" status={c.status} class="shrink-0">
                {statusLabel[c.status]}
              </Chip>
              <p class="copy-tech m-0 text-[14px]">{c.text}</p>
            </div>
          ))
        }
        <div>
          <a
            href={`/ecosystem/${host.slug}/`}
            class="inline-block bg-yellow px-6 py-3.5 font-display text-[15px] font-black uppercase tracking-[0.04em] text-field no-underline hover:bg-legend"
            >Pinout &amp; files</a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="wrap py-16">
    <Eyebrow class="mb-4">The satellites</Eyebrow>
    <h2 class="display m-0 mb-4 max-w-[680px] text-[clamp(30px,4.6vw,44px)]">
      Four controls at a time, or one
    </h2>
    <p class="copy-tech m-0 mb-10 max-w-[620px] text-[15px]">
      Each satellite reads its own controls and passes them along a chain. The last one closes
      the ring by itself, and a satellite’s position in the chain is its address — so growing a
      panel means plugging in another board, never respinning the motherboard. The banks put
      four controls on a 25 mm grid; the singles are for the knob that does not belong in a row.
    </p>
    <ul class="m-0 grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {satellites.map((b) => <BoardCard board={b} />)}
    </ul>
  </section>

  <section class="wrap pb-16">
    <Eyebrow class="mb-4">The daughterboards</Eyebrow>
    <h2 class="display m-0 mb-4 max-w-[680px] text-[clamp(30px,4.6vw,44px)]">
      Everything that reaches the outside world
    </h2>
    <p class="copy-tech m-0 mb-10 max-w-[620px] text-[15px]">
      Jacks, power and MIDI leave the motherboard in Rev-B and bolt to the rear rail. It keeps
      the host board smaller, and it means the connectors a build does not need are connectors
      it does not pay for.
    </p>
    <ul class="m-0 grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {daughterboards.map((b) => <BoardCard board={b} />)}
    </ul>
  </section>

  <CtaBand
    source="ecosystem"
    heading="Build one?"
    body="Rodeo goes to Kickstarter in January 2027. Join the waitlist to hear first, and to watch these boards come back from the fab."
  />
</BaseLayout>
