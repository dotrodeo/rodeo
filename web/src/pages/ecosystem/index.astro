---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Chip from '../../components/Chip.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import BoardFigure from '../../components/BoardFigure.astro';
import SpecTable from '../../components/SpecTable.astro';
import CtaBand from '../../components/CtaBand.astro';
import { host, satellites, retired } from '../../data/boards';
import { statusLabel } from '../../data/site';

const legend = [
  { status: 'shipped' as const, label: 'Verified', note: 'proven on real hardware' },
  { status: 'in-progress' as const, label: 'In bring-up', note: 'fabbed, still being tested' },
  { status: 'planned' as const, label: 'Open item', note: 'a known gap, named on the board’s page' },
];
---

<BaseLayout
  title="The boards"
  description="One host board and the satellites that plug into it. Every entry links to its schematic, KiCad project, gerbers, BOM and pinout."
>
  <section class="wrap flex flex-col gap-10 py-14 lg:flex-row lg:items-end">
    <div class="flex grow flex-col gap-4">
      <Eyebrow>The platform</Eyebrow>
      <h1 class="display m-0 max-w-[720px] text-[clamp(42px,7vw,64px)]">
        One host board and the satellites that plug into it
      </h1>
      <p class="copy-tech m-0 max-w-[620px] text-[16px]">
        Every entry links to its schematic, KiCad project, gerbers, BOM and pinout. Status is
        what has been proven on hardware — not what has been designed.
      </p>
    </div>
    <ul class="m-0 flex list-none flex-col gap-2.5 p-0">
      {
        legend.map((l) => (
          <li class="flex items-center gap-2.5">
            <Chip variant="status" status={l.status}>
              {l.label}
            </Chip>
            <span class="text-[13.5px] text-hardware">{l.note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap pb-6">
    <div class="flex flex-col gap-10 border border-rule bg-field-raised p-6 lg:flex-row sm:p-8">
      <div class="lg:w-[46%] lg:shrink-0">
        <BoardFigure
          src={host.shot!.src}
          alt={host.shot!.alt}
          media={host.shot!.media}
          rev={host.rev}
          caption={host.shot!.caption}
          widths={[500, 800, 1200]}
          sizes="(max-width: 1024px) 100vw, 520px"
        />
      </div>
      <div class="flex min-w-0 grow flex-col gap-5">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="display m-0 text-[clamp(26px,3.4vw,34px)] normal-case">{host.name}</h2>
          <Chip variant="status" status={host.status}>{statusLabel[host.status]}</Chip>
        </div>
        <p class="copy-tech m-0 text-[15.5px]">{host.body}</p>
        <SpecTable specs={host.specs} />
        {
          host.caveats?.map((c) => (
            <div class="flex items-start gap-3 border-l-2 border-rule bg-field p-4">
              <Chip variant="status" status={c.status} class="shrink-0">
                {statusLabel[c.status]}
              </Chip>
              <p class="copy-tech m-0 text-[14px]">{c.text}</p>
            </div>
          ))
        }
        <div>
          <a
            href={`/ecosystem/${host.slug}/`}
            class="inline-block bg-yellow px-6 py-3.5 font-display text-[15px] font-black uppercase tracking-[0.04em] text-field no-underline hover:bg-legend"
            >Pinout &amp; files</a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="wrap py-16">
    <Eyebrow class="mb-4">The satellites</Eyebrow>
    <h2 class="display m-0 mb-10 max-w-[680px] text-[clamp(30px,4.6vw,44px)]">
      A board per control, on a 25 mm grid
    </h2>
    <ul class="m-0 grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4">
      {
        satellites.map((b) => (
          <li class="h-full">
            <a
              href={`/ecosystem/${b.slug}/`}
              class="group flex h-full flex-col gap-4 border border-rule bg-field-raised p-5 text-legend no-underline hover:border-yellow"
            >
              <img
                src={b.shot!.src.src}
                width={b.shot!.src.width}
                height={b.shot!.src.height}
                alt={b.shot!.alt}
                loading="lazy"
                decoding="async"
                class="block aspect-square w-full rounded-[8px] object-cover"
              />
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="display m-0 text-[17px] normal-case group-hover:text-yellow">
                  {b.name}
                </h3>
                <Chip variant="status" status={b.status}>
                  {statusLabel[b.status]}
                </Chip>
              </div>
              <p class="copy-tech m-0 text-[14px]">{b.summary}</p>
              <span class="mt-auto font-mono text-[12px] text-hardware">
                Rev-{b.rev} · {b.shot!.media === 'photo' ? 'photo' : 'CAD render'}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap flex flex-col gap-8 pb-20 lg:flex-row">
    <div class="flex max-w-[280px] flex-col gap-2.5">
      <Chip variant="status" status="retired" class="self-start">Retired</Chip>
      <p class="copy-tech m-0 text-[14px]">
        Designed, then cut. The files stay published; they are not part of the platform.
      </p>
    </div>
    <dl class="m-0 grow">
      {
        retired.map((b) => (
          <div class="flex flex-col gap-1 border-t border-rule py-3.5 sm:flex-row sm:gap-5">
            <dt class="w-[210px] shrink-0 font-mono text-[14px] text-hardware line-through">
              {b.name}
            </dt>
            <dd class="copy-tech m-0 text-[14px]">{b.retiredReason}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <CtaBand
    source="ecosystem"
    heading="Build one?"
    body="Rodeo launches on Kickstarter in January 2027. Join the waitlist to hear first, and to follow the boards as they are finished."
  />
</BaseLayout>
