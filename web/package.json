{
  "name": "rodeo-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "worker": "astro build && wrangler dev",
    "check": "astro check && tsc -p worker/tsconfig.json && node scripts/check-claims.mjs && node scripts/check-assets.mjs",
    "assets": "node scripts/check-assets.mjs",
    "claims": "node scripts/check-claims.mjs",
    "renders": "node scripts/shrink-renders.mjs",
    "photos": "node scripts/prepare-photos.mjs",
    "verify": "npm run check && npm run build && node scripts/check-links.mjs && node scripts/check-a11y.mjs",
    "links": "node scripts/check-links.mjs",
    "a11y": "node scripts/check-a11y.mjs",
    "og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "@astrojs/starlight": "^0.36.3",
    "@astrojs/starlight-tailwind": "^4.0.1",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.0.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20261015.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.151.0"
  }
}
