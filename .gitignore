# --- OS ---
.DS_Store

# --- VS Code "Local History" extension snapshots ---
.history/

# --- KiCad backups & autosave ---
*.bak
*-bak
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups/
_autosave-*
*.000

# --- KiCad lock & cache files ---
*.lck
~*.lck
fp-info-cache

# --- KiCad temporary DRC/ERC report files ---
tmp*.rpt

# --- Firmware build output & local toolchain config ---
build/
config.mk
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.lst

# --- Non-public files ---
kickstarter/

# --- Rodeo KiCad tools: local Python environment ---
tools/kicad/.venv/
tools/kicad/.kikit/
# KiKit panels: regenerated by jlc_fab.py --panel; the JLC files are in jlcpcb-panel/
hardware/*/panel/
__pycache__/

# --- Board and panel STEP exports (jlc_fab.py writes them beside each .kicad_pcb, for
# renders); part models in lib/*.3dshapes/ are tracked ---
hardware/*/*.step
hardware/panels/*/*.step

# rodeo-sdk API reference generator (make docs)
rodeo-sdk/tools/docs/.venv/

# rodeo-satellite host test build
rodeo-satellite/tests/build/
